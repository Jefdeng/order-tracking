# Copy to .env and fill in. Never commit .env.

# --- LLM (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Google ---
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
# Required: the ID from your sheet's URL: docs.google.com/spreadsheets/d/<THIS PART>/edit (a full URL also works)
SHEET_ID=
WORKSHEET_NAME=Procurement Detail   # the tab containing the table (the app finds the header row itself)

# --- Safety ---
# true = log what would change but don't write to the sheet. Flip to false once the logs look right.
DRY_RUN=true

# --- Ingestion ---
# poll   = check Gmail every POLL_INTERVAL_SECONDS. No ngrok / Pub/Sub needed. (default)
# pubsub = Gmail pushes to /api/webhook/gmail via Pub/Sub + ngrok.
INGEST_MODE=poll
POLL_INTERVAL_SECONDS=15

# Only used when INGEST_MODE=pubsub:
# PUBSUB_TOPIC=projects/YOUR_PROJECT_ID/topics/gmail-push
# PUBSUB_AUDIENCE=tracking-app-webhook
# PUBSUB_SERVICE_ACCOUNT=pubsub-push@YOUR_PROJECT_ID.iam.gserviceaccount.com

# --- Misc ---
# MAX_BODY_CHARS=12000
# LOG_LEVEL=INFO
